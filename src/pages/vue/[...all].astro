---
import "../../styles/global.css";
import VueHost from "@/router/VueHost.vue";

export function getStaticPaths() {
    return [
        { params: { all: undefined } }, // /vue
        { params: { all: "sub" } }, // /vue/sub
    ];
}
---

<!doctype html>
<html lang="ko">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Vue SPA Dashboard</title>
    </head>
    <body class="p-8 font-sans bg-gray-50 text-gray-900">
        <VueHost client:only="vue" />
    </body>
</html>
