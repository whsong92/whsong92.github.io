---
import "../../styles/global.css";
import ReactRouter from "@/router/reactRouter";

export function getStaticPaths() {
    return [
        { params: { all: undefined } }, // /react
        { params: { all: "sub" } }, // /react/sub
    ];
}
---

<!doctype html>
<html lang="ko">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>React SPA Studio</title>
    </head>
    <body class="p-8 font-sans bg-gray-50 text-gray-900">
        <ReactRouter client:only="react" />
    </body>
</html>
