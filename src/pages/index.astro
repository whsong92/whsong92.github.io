---
import "../styles/global.css";
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <title>Main Hub</title>
  </head>
  <body class="p-8 font-sans bg-gray-50 text-gray-900">
    <h1 class="text-2xl font-bold mb-4">Astro Main Gateway</h1>
    <p class="text-gray-600 mb-6">Hello World from Astro!</p>

    <div class="flex flex-wrap gap-4">
      <a
        href="/react"
        class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700"
        >React 사이트로 이동</a
      >
      <a
        href="/vue"
        class="px-4 py-2 bg-emerald-600 text-white rounded hover:bg-emerald-700"
        >Vue 사이트로 이동</a
      >
      <a
        href="/svelte"
        class="px-4 py-2 bg-amber-600 text-white rounded hover:bg-amber-700"
        >Svelte 사이트로 이동</a
      >
    </div>
  </body>
</html>
