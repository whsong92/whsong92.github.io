---
import BaseLayout from "../layouts/BaseLayout.astro";
import fs from "node:fs";
import path from "node:path";

interface PostMeta {
  slug: string;
  title: string;
  date: string;
  category: "learning" | "ai" | "etc";
  subject: string;
  subjectId?: string;
  description?: string;
}

const listDir = path.resolve(process.cwd(), "public/data/lists");

let allPosts: PostMeta[] = [];
let learningTotal = 0;
let aiTotal = 0;
let etcTotal = 0;

// 빌드 스크립트가 생성한 lists JSON 로드
if (fs.existsSync(path.join(listDir, "all.json"))) {
  allPosts = JSON.parse(fs.readFileSync(path.join(listDir, "all.json"), "utf-8"));
}
if (fs.existsSync(path.join(listDir, "learning.json"))) {
  learningTotal = JSON.parse(fs.readFileSync(path.join(listDir, "learning.json"), "utf-8")).total || 0;
}
if (fs.existsSync(path.join(listDir, "ai.json"))) {
  aiTotal = JSON.parse(fs.readFileSync(path.join(listDir, "ai.json"), "utf-8")).total || 0;
}
if (fs.existsSync(path.join(listDir, "etc.json"))) {
  etcTotal = JSON.parse(fs.readFileSync(path.join(listDir, "etc.json"), "utf-8")).total || 0;
}

// 3대 격리 런타임 텔레메트리 카드 구성
const channels = [
  {
    id: "01",
    name: "SYSTEM // DEV",
    runtime: "SVELTE 5",
    route: "/svelte",
    total: learningTotal,
    border: "hover:border-topic-learning",
    badge: "bg-topic-learning/10 text-topic-learning border-topic-learning/30",
    dot: "bg-topic-learning",
  },
  {
    id: "02",
    name: "COGNITION // AI",
    runtime: "REACT 19",
    route: "/react",
    total: aiTotal,
    border: "hover:border-topic-ai",
    badge: "bg-topic-ai/10 text-topic-ai border-topic-ai/30",
    dot: "bg-topic-ai",
  },
  {
    id: "03",
    name: "ARCHIVE // ETC",
    runtime: "VUE 3",
    route: "/vue",
    total: etcTotal,
    border: "hover:border-topic-etc",
    badge: "bg-topic-etc/10 text-topic-etc border-topic-etc/30",
    dot: "bg-topic-etc",
  },
];

const categoryTheme = {
  learning: {
    label: "[01 // SVELTE]",
    route: "/svelte",
    barColor: "bg-topic-learning",
    textColor: "text-topic-learning",
    ledBar: "group-hover:led-learning",
    glowText: "group-hover:glow-learning",
  },
  ai: {
    label: "[02 // REACT]",
    route: "/react",
    barColor: "bg-topic-ai",
    textColor: "text-topic-ai",
    ledBar: "group-hover:led-ai",
    glowText: "group-hover:glow-ai",
  },
  etc: {
    label: "[03 // VUE]",
    route: "/vue",
    barColor: "bg-topic-etc",
    textColor: "text-topic-etc",
    ledBar: "group-hover:led-etc",
    glowText: "group-hover:glow-etc",
  },
};
---

<BaseLayout>
  <div class="max-w-4xl h-full mx-auto px-4 sm:px-6 md:px-8 py-8 sm:py-12 space-y-12">
    <!-- 시스템 관제 히어로 섹션 -->
    <section class="flex flex-col pt-2 border-b border-silver-line/40 pb-8">
      <div class="flex items-center gap-2 text-xs font-mono tracking-widest pb-3 text-silver-muted">
        <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>TELEMETRY CONSOLE // DISPATCH V4</span>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-heading font-bold uppercase text-paper tracking-tighter mb-2">
        SWH ARCHIVE CORE
      </h1>

      <p class="text-silver-muted text-xs sm:text-sm leading-relaxed mb-6 max-w-xl">
        Decoupled personal knowledge base operating across three isolated frontend runtimes.
      </p>

      <!-- 상단 채널 네비게이션 바로가기 -->
      <nav
        class="flex items-center flex-wrap gap-2 text-xs font-mono text-silver-muted pt-2 border-t border-silver-line/30">
        <a class="text-paper font-semibold hover:underline" href="/">[ALL]</a>
        <span class="text-silver-line">/</span>
        <a class="hover:text-topic-learning transition-colors" href="/svelte">[01.DEV / SVELTE]</a>
        <span class="text-silver-line">/</span>
        <a class="hover:text-topic-ai transition-colors" href="/react">[02.AI / REACT]</a>
        <span class="text-silver-line">/</span>
        <a class="hover:text-topic-etc transition-colors" href="/vue">[03.ETC / VUE]</a>
      </nav>
    </section>

    <!-- 3단 런타임 상태 대시보드 카드 -->
    <section class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {
        channels.map((ch) => (
          <a
            href={ch.route}
            class={`group p-4 bg-[#0d0f14] border border-silver-line/40 rounded transition-all duration-200 ${ch.border} flex flex-col justify-between space-y-4`}>
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono text-silver-muted">{ch.id}</span>
              <span class={`text-[10px] font-mono px-2 py-0.5 rounded border ${ch.badge}`}>{ch.runtime}</span>
            </div>

            <div>
              <h2 class="text-sm font-bold font-mono text-paper group-hover:text-white flex items-center gap-2">
                <span class={`w-1.5 h-1.5 rounded-full ${ch.dot}`} />
                {ch.name}
              </h2>
              <div class="mt-2 text-xs font-mono text-silver-muted">
                STORED_DISPATCHES: <span class="text-paper font-bold">{ch.total}</span>
              </div>
            </div>

            <div class="text-[11px] font-mono text-silver-muted group-hover:text-paper transition flex items-center justify-between pt-2 border-t border-silver-line/20">
              <span>ENTER RUNTIME</span>
              <span>↗</span>
            </div>
          </a>
        ))
      }
    </section>

    <!-- 섹션 헤더: 비대칭 라인 -->
    <section class="space-y-4 pt-4">
      <div class="flex items-center gap-3 sm:gap-4">
        <div class="w-1 h-6 sm:h-8 bg-paper led-white shrink-0"></div>
        <div>
          <span class="text-[10px] font-mono text-silver-muted uppercase tracking-wider block">DISPATCH CATALOG</span>
          <h2 class="text-lg sm:text-xl md:text-2xl font-heading font-bold text-paper tracking-tight uppercase">
            SELECTED ESSAYS
          </h2>
        </div>
      </div>

      <div class="w-full flex justify-end">
        <div class="w-full sm:w-3/5 h-px bg-silver-line"></div>
      </div>
    </section>

    <!-- 실시간 글 목록 피드 (readTime 제거, 날짜 및 서브젝트 정렬) -->
    <section class="divide-y divide-silver-line border-b border-silver-line">
      {
        allPosts.map((post, index) => {
          const idx = String(index + 1).padStart(2, "0");
          const theme = categoryTheme[post.category] || categoryTheme.etc;
          const postLink = `${theme.route}?slug=${post.slug}`;

          return (
            <article class="relative py-5 sm:py-6 pl-4 sm:pl-5 group transition-all duration-150">
              <div
                class={`absolute left-0 top-5 bottom-5 sm:top-6 sm:bottom-6 w-[2px] ${theme.barColor} opacity-40 group-hover:opacity-100 ${theme.ledBar} transition-all duration-200`}
              />

              <div class="flex flex-col sm:flex-row sm:items-center justify-between text-xs font-mono text-silver-muted mb-2 gap-1 sm:gap-0">
                <div class="flex items-center gap-2.5 sm:gap-3">
                  <span class="font-bold text-paper">{idx}</span>
                  <a
                    href={theme.route}
                    class={`text-[16px] font-semibold tracking-wider hover:underline ${theme.textColor} ${theme.glowText} transition-all duration-200`}>
                    {post.subject}
                  </a>
                </div>
                <span class="text-[13px] font-mono text-silver-muted">{post.date}</span>
              </div>

              <a class="block space-y-1.5" href={postLink}>
                <h3 class="text-base sm:text-lg md:text-xl font-heading font-semibold text-paper tracking-tight group-hover:text-white transition-colors">
                  {post.title}
                </h3>
                {post.description && (
                  <p class="text-xs sm:text-sm text-silver-muted leading-relaxed line-clamp-2">{post.description}</p>
                )}
              </a>
            </article>
          );
        })
      }
    </section>
  </div>
</BaseLayout>
