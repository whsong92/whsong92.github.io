---
import "../../styles/global.css";
import SvelteRouter from "@/router/SvelteRouter.svelte";

export function getStaticPaths() {
    return [
        { params: { all: undefined } }, // /svelte
        { params: { all: "sub" } }, // /svelte/sub
    ];
}
---

<!doctype html>
<html lang="ko">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Svelte SPA Lab</title>
    </head>
    <body class="p-8 font-sans bg-gray-50 text-gray-900">
        <SvelteRouter client:only="svelte" />
    </body>
</html>
